            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "echo '>>> cleaning compiled files' && find . -type d -name '__pycache__' -prune -exec rm -r {} + && find . -type d -name '.pytest_cache' -prune -exec rm -r {} +",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "clean_git_ignored_files",
            "type": "shell",
            "command": "echo '>>> Files ignored by git (dry run, nothing is deleted)' && git clean -nXd",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "login_to_azure",
            "type": "shell",
