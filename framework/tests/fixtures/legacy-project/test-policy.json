      "title": "Discovery before modeling, training-only analysis, and safe HTML",
      "changes": [
        "data",
        "features",
        "model",
        "pilot",
        "interface",
        "dependencies",
        "refactor"
      ],
      "phases": [
        "pr",
        "release"
      ],
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/test_discovery.py"
      ],
      "timeout": 120
    },
    {
      "id": "quality",
      "title": "Policy, failures, and stale evidence",
      "changes": [
        "data",
        "features",
        "model",
        "refactor",
        "dependencies",
        "deployment",
        "interface",
        "pilot"
      ],
      "phases": [
        "pr",
        "release"
      ],
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/test_quality.py"
      ],
      "timeout": 120
