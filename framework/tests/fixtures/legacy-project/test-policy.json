{
  "version": 1,
  "context_paths": [
    "test-policy.json",
    "ticket.json",
    "src",
    "tests",
    "scripts",
    "mlkit",
    "model",
    "project.yaml",
    "frame.yaml",
    "features.yaml",
    "requirements.txt",
    "requirements-local.txt",
    "pyproject.toml",
    "uv.lock",
    ".ci",
    "docs"
  ],
  "suites": [
    {
      "id": "reliability",
      "title": "Idempotent revisions, interruption, and data exposure",
      "changes": [
        "pilot",
        "interface",
        "data",
        "features",
        "refactor"
      ],
      "phases": [
        "pr",
        "release"
      ],
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/test_reliability.py"
      ],
      "timeout": 120
    },
    {
      "id": "contracts",
      "title": "Contracts, pilot, and resumption",
      "changes": [
        "data",
        "features",
        "model",
        "refactor",
        "dependencies",
        "deployment",
        "interface",
        "pilot"
      ],
      "phases": [
        "pr",
        "release"
      ],
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/test_pilot_revision.py"
      ],
      "timeout": 120
    },
    {
      "id": "classical",
      "title": "Classical ML, splitting, and constraints",
      "changes": [
        "data",
        "features",
        "model",
        "refactor",
        "dependencies"
      ],
      "phases": [
        "pr",
        "release"
      ],
      "command": [
